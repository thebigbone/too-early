{
  "name": "too-early",
  "private": true,
  "version": "0.1.0",
  "homepage": "https://thebigbone.github.io/too-early/",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:corpus && tsc -b && vite build",
    "build:corpus": "npm run merge:agents && tsx scripts/build-corpus.ts",
    "preview": "vite preview",
    "check": "tsc -b --noEmit",
    "validate:data": "npm run build:corpus",
    "verify:hn": "npm run merge:agents && tsx scripts/verify-hn.ts",
    "merge:agents": "tsx scripts/merge-agents.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "clsx": "^2.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vite": "^7.3.1"
  }
}
